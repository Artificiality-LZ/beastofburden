<window size="190 352" pause="false" lightbox="false">
    <image source="minecolonies:textures/gui/builderhut/builder_paper.png" size="190 352"/>
    <label size="164 11" pos="13 14" textalign="MIDDLE" color="black"
           label="$(com.beastofburden.gui.townhall.workers)"/>

    <list id="workers" size="164 24" pos="13 25">
        <view size="100% 11">
            <box size="100% 11" linewidth="0">
                <label id="workerName" size="100% 11" pos="0 0" textalign="MIDDLE" color="black"/>
            </box>
        </view>
    </list>

    <buttonimage id="hire" size="129 17" pos="30 52" textcolor="black"
                 source="minecolonies:textures/gui/builderhut/builder_button_medium_large.png"
                 label="$(com.minecolonies.coremod.gui.workerhuts.manage)"/>
    <buttonimage id="recall" size="129 17" pos="30 70" textcolor="black"
                 source="minecolonies:textures/gui/builderhut/builder_button_medium_large.png"
                 label="$(com.minecolonies.coremod.gui.workerhuts.recall)"/>

    <buttonimage id="togglePlanning" size="129 17" pos="30 88" textcolor="black"
                 source="minecolonies:textures/gui/builderhut/builder_button_medium_large.png"
                 label="$(com.beastofburden.gui.townhall.planning_off)"/>
    <buttonimage id="cyclePlanningMode" size="129 17" pos="30 106" textcolor="black"
                 source="minecolonies:textures/gui/builderhut/builder_button_medium_large.png"
                 label="$(com.beastofburden.gui.townhall.planning_mode.scripted)"/>
    <buttonimage id="editPlan" size="129 17" pos="30 124" textcolor="black"
                 source="minecolonies:textures/gui/builderhut/builder_button_medium_large.png"
                 label="$(com.beastofburden.gui.townhall.edit_plan)"/>
    <label id="planningStatus" size="164 10" pos="13 142" textalign="MIDDLE" color="black" textscale="0.85"/>
    <label id="planningDetail" size="164 10" pos="13 153" textalign="MIDDLE" color="black" textscale="0.8"/>

    <label id="activeTitle" size="164 11" pos="13 173" textalign="MIDDLE" color="black"
           label="$(com.beastofburden.gui.townhall.active_work)"/>
    <list id="activeWork" size="164 48" pos="13 184">
        <view size="100% 26">
            <box size="100% 26" linewidth="0">
                <itemicon id="activeIcon" size="14 14" pos="2 6"/>
                <label id="activeLine" size="142 10" pos="18 2" textalign="MIDDLE_LEFT" color="black" textscale="0.85"/>
                <label id="activeItem" size="142 10" pos="18 12" textalign="MIDDLE_LEFT" color="black"/>
                <gradient id="activeProgress" size="0 3" pos="18 22" gradientstart="4283215696" gradientend="4283215696"/>
            </box>
        </view>
    </list>

    <label id="historyTitle" size="164 11" pos="13 235" textalign="MIDDLE" color="black"
           label="$(com.beastofburden.gui.townhall.work_history)"/>
    <label id="historyNote" size="164 9" pos="13 246" textalign="MIDDLE" color="black" textscale="0.85"/>
    <list id="history" size="164 86" pos="13 257">
        <view size="100% 24">
            <box size="100% 24" linewidth="0">
                <itemicon id="historyIcon" size="14 14" pos="2 5"/>
                <label id="historyMeta" size="142 10" pos="18 2" textalign="MIDDLE_LEFT" color="black" textscale="0.85"/>
                <label id="historyItem" size="142 12" pos="18 12" textalign="MIDDLE_LEFT" color="black" textscale="0.9"/>
            </box>
        </view>
    </list>
</window>
